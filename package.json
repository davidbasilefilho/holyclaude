{
  "name": "holyclaude",
  "version": "0.2.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugin"
  ],
  "type": "module",
  "scripts": {
    "fmt": "mise run fmt",
    "fmt:readonly": "mise run fmt:readonly",
    "lint": "mise run lint",
    "lint:readonly": "mise run lint:readonly",
    "typecheck": "mise run typecheck",
    "check": "mise run check",
    "check:fix": "mise run check:fix",
    "test": "mise run test",
    "build": "mise run build",
    "bump:minor": "mise run bump:minor",
    "bump:patch": "mise run bump:patch",
    "bump:hotfix": "mise run bump:hotfix"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.300",
    "@holyclaude/core": "workspace:*",
    "@types/bun": "^1.0.0",
    "effect": "^4.0.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.0",
    "typescript": "^7.0.0"
  },
  "packageManager": "bun@1.4.3"
}
