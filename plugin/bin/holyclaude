#!/bin/sh
# Runs the bundled holyclaude CLI with Bun. Without Bun, hooks exit 0 silently so sessions go on.
# A set CDPATH makes `cd` print the directory it finds, which would corrupt the path below.
unset CDPATH
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd -P)
bun=$(command -v bun 2>/dev/null)
[ -z "$bun" ] && [ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ] && bun="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
if [ -z "$bun" ] || [ ! -f "$here/holyclaude.js" ]; then
  [ "$1" = hook ] && exit 0
  printf 'error: "BunMissing: Bun or holyclaude.js was not found; install Bun from https://bun.sh, then rerun this command."\n' >&2
  exit 127
fi
# The working directory is the project, and Bun would load its .env and bunfig.toml there: an .env
# could redirect the state file and a bunfig preload would run code on every call. Neither may
# change this CLI, so Bun reads no env file and an empty config.
exec "$bun" --no-env-file --config=/dev/null "$here/holyclaude.js" "$@"
